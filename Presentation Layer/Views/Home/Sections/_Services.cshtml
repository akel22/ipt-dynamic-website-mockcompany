@model _241419_DynamicWebsite.Models.CompanyContent

<section id="services" class="section-shell section-muted" aria-labelledby="services-title">
    <div class="text-center section-heading">
        <p class="eyebrow text-muted">@Model.ServicesEyebrow</p>
        <h2 id="services-title">@Model.ServicesTitle</h2>
    </div>
    <div class="row g-4">
        @foreach (var service in Model.Services.OrderBy(item => item.Id))
        {
            <div class="col-md-4">
                <article class="service-card h-100">
                    <h3 class="mt-2">@service.Name</h3>
                    <p>@service.Description</p>
                </article>
            </div>
        }
    </div>
</section>
