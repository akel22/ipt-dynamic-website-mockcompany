@model _241419_DynamicWebsite.Models.CompanyContent

<section id="about" class="section-shell" aria-labelledby="about-title">
    <div class="row g-5 align-items-center">
        <div class="col-md-5">
            <p class="eyebrow">@Model.AboutEyebrow</p>
            <h2 id="about-title">@Model.AboutTitle</h2>
        </div>
        <div class="col-md-7">
            <p class="section-copy">@Model.AboutDescription</p>
            <p class="section-copy mb-0">@Model.AboutSecondaryDescription</p>
        </div>
    </div>
</section>
