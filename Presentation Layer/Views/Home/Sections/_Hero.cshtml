@model _241419_DynamicWebsite.Models.CompanyContent

<section class="hero-section section-shell" aria-labelledby="hero-title">
    <div class="row align-items-center g-5">
        <div class="col-lg-7 mt-2">
            <h1 id="hero-title" class="display-3 fw-bold">@Model.HeroTitle</h1>
            <p class="lead mt-4">@Model.HeroDescription</p>
            <a class="btn btn-primary btn-lg mt-3" href="@Model.HeroCtaTarget">@Model.HeroCtaText</a>
        </div>
       
    </div>
</section>
