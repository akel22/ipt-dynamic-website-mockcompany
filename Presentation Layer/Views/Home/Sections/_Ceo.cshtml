@model _241419_DynamicWebsite.Models.CompanyContent

<section id="ceo" class="section-shell" aria-labelledby="ceo-title">
    <div class="row align-items-center g-5">
        <div class="col-md-4">
            <div class="ceo-placeholder" role="img" aria-label="CEO portrait placeholder">
                <img src="assets/img/ezekiel.jpg" alt="CEO Portrait" class="img-fluid rounded-circle" />
            </div>
        </div>
        <div class="col-md-8">
            <p class="eyebrow">@Model.CeoEyebrow</p>
            <h2 id="ceo-title">@Model.CeoTitle</h2>
            <p class="section-copy">@Model.ChiefExecutiveDescription</p>
            <p class="fw-semibold mb-0">@Model.ChiefExecutiveName <span class="text-muted fw-normal">· @Model.ChiefExecutiveTitle</span></p>
        </div>
    </div>
</section>
