@model AdminUserDetailsDto

@{
    ViewData["Title"] = "User details";
}

<div class="admin-page-heading">
    <div>
        <h3 class="mb-1">User details</h3>
        <p class="admin-page-copy mb-0">Read-only account information for this user.</p>
    </div>
</div>

<section class="admin-card">
    <div class="admin-card-heading">
        <div>
            <h2>@Model.UserName</h2>
            <p>@Model.Email</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label class="form-label">Username</label>
            <div class="form-control bg-light">@Model.UserName</div>
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label">Email</label>
            <div class="form-control bg-light">@Model.Email</div>
        </div>
      
        <div class="col-12 col-md-6">
            <label class="form-label">Date of birth</label>
            <div class="form-control bg-light">@Model.DateOfBirth.ToString("MMM d, yyyy")</div>
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label">Occupation status</label>
            <div class="form-control bg-light">@Model.OccupationStatus</div>
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label">Status</label>
            <div class="form-control bg-light">@(Model.IsActive ? "Active" : "Inactive")</div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Users" class="btn btn-outline-secondary btn-sm">Back to users</a>
    </div>
</section>
